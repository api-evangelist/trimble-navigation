{
  "opencollection": "1.0.0",
  "info": {
    "name": "Trimble Mobile Manager Catalyst System API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "System",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get TMM System Information",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:{apiPort}/api/v1/tmmInfo"
          },
          "docs": "Retrieve system information about the connected Trimble Mobile Manager instance, including the API port, WebSocket ports, connected receiver details, and version information."
        }
      ]
    }
  ],
  "bundled": true
}