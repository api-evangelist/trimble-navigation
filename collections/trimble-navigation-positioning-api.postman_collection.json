          "id": "6f9bea3f-255b-4508-8573-449fb9f2e005",
          "name": "Start Position Stream",
          "request": {
            "name": "Start Position Stream",
            "description": {
              "content": "Initiates position streaming from the connected GNSS receiver. Returns the WebSocket port number for connecting to the position stream. After calling this endpoint, open a WebSocket connection to ws://localhost:{port} to receive real-time GNSS position data.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "positionStream"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "format",
                  "value": "locationV2",
                  "description": "Position data format version. locationV2 includes extended fields for IMU orientation, TIP positions, and reference frame data."
                }
              ],
              "variable": [
                {
                  "description": "API port returned by tmmInfo endpoint",
                  "type": "any",
                  "value": "{{apiPort}}",
                  "key": "apiPort"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
